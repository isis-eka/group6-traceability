# Secrets: never upload
.env

# Downloaded copies of requests/flask (large, rebuilt by scripts)
workspace/

# Python clutter
__pycache__/
*.pyc
.venv/
venv/

# Editor / OS clutter
.DS_Store
.vscode/
.idea/

# Raw SWE-bench data (rebuilt by load_swebench.py / export_issue_text.py).
# issues.jsonl holds the fixes and tests, i.e. the answers.
data/issues.jsonl
data/issue_text.jsonl

# Answer keys: never in git (Sammi and the model must not see them). Shared privately.
data/labels*.jsonl

# Embedded search index (rebuilt by src/build_index.py)
data/index_v1/

# Per-case score tables list the answer key tests, so they stay off GitHub like labels*.jsonl
results/**/*_summary.csv
