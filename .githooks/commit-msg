#!/bin/sh
# Blocks AI-assisted commits that have no ai-log entry (SE201 AI Use Disclosure Policy).
# Enable once per clone: git config core.hooksPath .githooks
# First interpreter that actually runs (on Windows, python3 can be a Microsoft Store stub)
PY=
for c in python3 python py; do
  if command -v "$c" >/dev/null 2>&1 && "$c" -c "" >/dev/null 2>&1; then PY=$c; break; fi
done
if [ -z "$PY" ]; then
  echo "ai-disclosure: python not found, skipping check" >&2
  exit 0
fi
exec "$PY" "$(git rev-parse --show-toplevel)/tools/ai_disclosure.py" commit-msg "$1"
